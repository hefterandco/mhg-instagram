# Copy to .env ONLY for testing on your own computer. Never commit .env.
# In GitHub these same values go in Settings > Secrets and variables > Actions.

# SECRET: your Instagram professional account's user ID (a long number).  SETUP.md step 4
IG_USER_ID=________________

# SECRET: long-lived Instagram user access token (lasts 60 days, auto-refreshed weekly).  SETUP.md step 4
IG_ACCESS_TOKEN=________________

# SECRET: GitHub fine-grained token that can write this repo's secrets (for the weekly refresh).  SETUP.md step 6
GH_SECRETS_TOKEN=________________

# Optional variable: API version. Blank = v26.0 (the version the poster is pinned to).
IG_GRAPH_VERSION=

# Optional variable: hours late before a post is marked "missed" instead of posted.
MAX_LATE_HOURS=6

# Only for local testing: where Instagram can download the images. In GitHub Actions this is automatic.
PUBLIC_BASE_URL=

# ---- faceedit (face-video editor, runs on your laptop) ----
# OPTIONAL SECRET: Pexels API key for stock B-roll. Pexels has paused new keys, so leave blank for now.
# Blank = B-roll comes only from ~/Movies/MHG-broll.  faceedit/README.md
PEXELS_API_KEY=________________

# Optional: GitHub token faceedit uses to upload Reels to the "reels" release. Leave blank to use the
# login your Mac saved when you last pushed. Fine-grained token, this repo only, Contents: Read and write.
GITHUB_TOKEN=________________
